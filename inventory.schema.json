{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopkeeper.local/schemas/inventory.schema.json",
  "title": "Inventory, cart, order and REST DTOs",
  "description": "Public DTOs for /api/v1. IDs are public string IDs (prod_001, var_001_L, ord_0001); internal DB UUIDs never cross this boundary.",
  "$defs": {
    "ProductId": { "type": "string", "pattern": "^prod_[A-Za-z0-9_]+$" },
    "VariantId": { "type": "string", "pattern": "^var_[A-Za-z0-9_]+$" },
    "OrderId": { "type": "string", "pattern": "^ord_[A-Za-z0-9_]+$" },
    "WaypointId": { "type": "string", "pattern": "^WP_[A-Z0-9_]+$" },
    "Vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "LabColor": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3,
      "description": "CIELAB [L, a, b]"
    },
    "ApiErrorCode": {
      "type": "string",
      "enum": ["UNAUTHORIZED", "VALIDATION_ERROR", "NOT_FOUND", "STOCK_INSUFFICIENT", "VERSION_CONFLICT", "IMAGE_INVALID", "RATE_LIMITED"]
    },
    "ApiError": {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": { "$ref": "#/$defs/ApiErrorCode" },
            "message": { "type": "string" },
            "details": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "HealthResponse": {
      "type": "object",
      "required": ["status", "postgres", "redis"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string" },
        "postgres": { "type": "string" },
        "redis": { "type": "string" }
      }
    },
    "SessionRequest": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["guest", "login"] },
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string", "minLength": 8 },
        "accessibility_mode": { "type": "boolean", "default": false }
      },
      "if": { "properties": { "mode": { "const": "login" } } },
      "then": { "required": ["email", "password"] }
    },
    "RegisterRequest": {
      "type": "object",
      "required": ["email", "password"],
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string", "minLength": 8 },
        "accessibility_mode": { "type": "boolean", "default": false }
      }
    },
    "SessionResponse": {
      "type": "object",
      "required": ["access_token", "session_id", "user_id", "expires_in"],
      "additionalProperties": false,
      "properties": {
        "access_token": { "type": "string" },
        "session_id": { "type": "string" },
        "user_id": { "type": "string" },
        "expires_in": { "type": "integer", "minimum": 1 }
      }
    },
    "ShelfProduct": {
      "type": "object",
      "required": ["product_id", "unity_prefab_id", "name", "base_price"],
      "additionalProperties": false,
      "properties": {
        "product_id": { "$ref": "#/$defs/ProductId" },
        "unity_prefab_id": { "type": "string" },
        "glb_model_url": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "base_price": { "type": "integer", "minimum": 0 }
      }
    },
    "Shelf": {
      "type": "object",
      "required": ["waypoint_id", "aisle_code", "position", "products"],
      "additionalProperties": false,
      "properties": {
        "waypoint_id": { "$ref": "#/$defs/WaypointId" },
        "aisle_code": { "type": "string" },
        "position": { "$ref": "#/$defs/Vector3" },
        "products": { "type": "array", "items": { "$ref": "#/$defs/ShelfProduct" } }
      }
    },
    "StoreLayout": {
      "type": "object",
      "required": ["shelves", "checkout_waypoint_id"],
      "additionalProperties": false,
      "properties": {
        "shelves": { "type": "array", "items": { "$ref": "#/$defs/Shelf" } },
        "checkout_waypoint_id": { "$ref": "#/$defs/WaypointId" }
      }
    },
    "ProductVariant": {
      "type": "object",
      "required": ["variant_id", "size", "color_name", "stock_qty", "price_delta"],
      "additionalProperties": false,
      "properties": {
        "variant_id": { "$ref": "#/$defs/VariantId" },
        "size": { "type": "string" },
        "color_name": { "type": "string" },
        "stock_qty": { "type": "integer", "minimum": 0 },
        "price_delta": { "type": "integer" }
      }
    },
    "ProductDetail": {
      "type": "object",
      "required": ["product_id", "name", "description", "base_price", "waypoint_id", "variants"],
      "additionalProperties": false,
      "properties": {
        "product_id": { "$ref": "#/$defs/ProductId" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "base_price": { "type": "integer", "minimum": 0 },
        "glb_model_url": { "type": ["string", "null"] },
        "waypoint_id": { "$ref": "#/$defs/WaypointId" },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/ProductVariant" } }
      }
    },
    "VisualSearchMatch": {
      "type": "object",
      "required": ["product_id", "name", "similarity_score", "delta_e00", "waypoint_id", "in_stock"],
      "additionalProperties": false,
      "properties": {
        "product_id": { "$ref": "#/$defs/ProductId" },
        "name": { "type": "string" },
        "similarity_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "delta_e00": { "type": "number", "minimum": 0 },
        "waypoint_id": { "$ref": "#/$defs/WaypointId" },
        "in_stock": { "type": "boolean" }
      }
    },
    "QualityWarning": { "enum": ["LOW_LIGHT", "OVEREXPOSED"] },
    "VisualSearchResponse": {
      "type": "object",
      "required": ["detected_color_name", "detected_lab", "category_label", "category_confidence", "is_in_domain", "quality_warning", "matches", "alternatives"],
      "additionalProperties": false,
      "properties": {
        "detected_color_name": { "type": "string" },
        "detected_lab": { "$ref": "#/$defs/LabColor" },
        "category_label": { "type": "string" },
        "category_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "is_in_domain": { "type": "boolean", "description": "true when category_confidence >= 0.45" },
        "quality_warning": { "oneOf": [{ "$ref": "#/$defs/QualityWarning" }, { "type": "null" }] },
        "matches": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/VisualSearchMatch" } },
        "alternatives": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/VisualSearchMatch" },
          "description": "In-stock, same-category items with delta_e00 < 10; only filled when the best match is out of stock."
        }
      }
    },
    "AddCartItemRequest": {
      "type": "object",
      "required": ["variant_id", "quantity"],
      "additionalProperties": false,
      "properties": {
        "variant_id": { "$ref": "#/$defs/VariantId" },
        "quantity": { "type": "integer", "minimum": 1 }
      }
    },
    "UpdateCartItemRequest": {
      "type": "object",
      "required": ["quantity"],
      "additionalProperties": false,
      "properties": { "quantity": { "type": "integer", "minimum": 1 } }
    },
    "CartItem": {
      "type": "object",
      "required": ["product_id", "variant_id", "name", "size", "quantity", "unit_price"],
      "additionalProperties": false,
      "properties": {
        "product_id": { "$ref": "#/$defs/ProductId" },
        "variant_id": { "$ref": "#/$defs/VariantId" },
        "name": { "type": "string" },
        "size": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unit_price": { "type": "integer", "minimum": 0 }
      }
    },
    "CartSummary": {
      "type": "object",
      "required": ["cart_id", "version", "items", "item_count", "total_amount"],
      "additionalProperties": false,
      "properties": {
        "cart_id": { "type": "string" },
        "version": { "type": "integer", "minimum": 0, "description": "Optimistic-lock version; sent back as If-Match." },
        "items": { "type": "array", "items": { "$ref": "#/$defs/CartItem" } },
        "item_count": { "type": "integer", "minimum": 0 },
        "total_amount": { "type": "integer", "minimum": 0 }
      }
    },
    "ShippingInfo": {
      "type": "object",
      "required": ["full_name", "address", "phone"],
      "additionalProperties": false,
      "properties": {
        "full_name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "minLength": 1 }
      }
    },
    "CheckoutRequest": {
      "type": "object",
      "required": ["shipping_info", "payment_method"],
      "additionalProperties": false,
      "properties": {
        "shipping_info": { "$ref": "#/$defs/ShippingInfo" },
        "payment_method": { "const": "SIMULATED" }
      }
    },
    "Order": {
      "type": "object",
      "required": ["order_id", "status", "total_amount", "items"],
      "additionalProperties": false,
      "properties": {
        "order_id": { "$ref": "#/$defs/OrderId" },
        "status": { "const": "CONFIRMED" },
        "total_amount": { "type": "integer", "minimum": 0 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/CartItem" } }
      }
    }
  }
}
